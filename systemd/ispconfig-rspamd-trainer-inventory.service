[Unit]
Description=Refresh ISPConfig Rspamd Trainer mailbox inventory
After=mariadb.service
Wants=mariadb.service

[Service]
Type=oneshot
User=root
Group=ispconfig-rspamd-trainer
ExecStartPre=/usr/bin/install -d -o ispconfig-rspamd-trainer -g ispconfig-rspamd-trainer -m 0750 /var/lib/ispconfig-rspamd-trainer
ExecStart=/usr/bin/php /usr/local/libexec/ispconfig-rspamd-trainer/export_mailboxes.php /var/lib/ispconfig-rspamd-trainer/mailboxes.json
# The state directory is owned by the unprivileged trainer service.
# This root helper writes only the inventory snapshot into that existing
# directory; it must not take ownership of the directory itself.
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ispconfig-rspamd-trainer
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
