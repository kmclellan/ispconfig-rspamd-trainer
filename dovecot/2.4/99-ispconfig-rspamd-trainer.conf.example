# ISPConfig Rspamd Trainer - Dovecot 2.4 IMAPSieve feedback example
#
# This file is an example/template. The installer must verify the target
# Dovecot version and effective mailbox naming before activating it.
#
# Design lineage:
# - Dovecot IMAPSieve documentation
# - jnorell/train-spam-scanner (BSD-2-Clause) as ISPConfig/Rspamd prior art
#
# No train-spam-scanner source is copied here; this uses Dovecot 2.4 syntax.

protocol imap {
  mail_plugins {
    imap_sieve = yes
  }
}

sieve_plugins {
  sieve_imapsieve = yes
  sieve_extprograms = yes
}

sieve_global_extensions {
  vnd.dovecot.pipe = yes
  vnd.dovecot.environment = yes
}

sieve_pipe_bin_dir = /usr/lib/dovecot/sieve-pipe

# Moving/copying a message into the Junk mailbox reports spam.
mailbox Junk {
  sieve_script ispconfig_rspamd_train_spam {
    type = before
    cause = copy
    path = /etc/dovecot/sieve/ispconfig-rspamd-report-spam.sieve
  }
}

# Moving/copying a message out of Junk reports ham. The ham Sieve script itself
# suppresses moves to Trash/deletion folders, which are not a ham signal.
imapsieve_from Junk {
  sieve_script ispconfig_rspamd_train_ham {
    type = before
    cause = copy
    path = /etc/dovecot/sieve/ispconfig-rspamd-report-ham.sieve
  }
}
